cabooga fibonacci ( cabooga n )
{
    pasar ( n pequenomismo 1 )
    {
        acasa n
    }

    acasa fibonacci ( n quitar 1 ) sumar fibonacci ( n quitar 2 )
}

cabooga OOGACHACKA ( )
{
    cabooga x ser 10
    cabooga k ser 20
    cabooga resultado ser 0

    resultado ser sumarNumeros ( x ,k )

    pasar ( resultado grande 15 y granverdad )
    {
        resultado ser resultado veces 2
    }
    nopasar
